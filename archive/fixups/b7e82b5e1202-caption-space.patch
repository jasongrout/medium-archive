6a88200753f"},"NewsletterV3:dc3fc4b27d22":{"__typename":"NewsletterV3","id":"dc3fc4b27d22","type":"NEWSLETTER_TYPE_AUTHOR","slug":"d6a88200753f","name":"d6a88200753f","collection":null,"user":{"__ref":"User:d6a88200753f"}},"User:d6a88200753f":{"__typename":"User","id":"d6a88200753f","name":"Wolf Vollprecht","username":"wolfv","newsletterV3":{"__ref":"NewsletterV3:dc3fc4b27d22"},"linkedAccounts":{"__ref":"LinkedAccounts:d6a88200753f"},"isSuspended":false,"customDomainState":{"__typename":"CustomDomainState","live":{"__typename":"CustomDomain","domain":"wolfv.medium.com"}},"hasSubdomain":true,"imageId":"2*ZLO4oRqnE48LRyueuRCgfA.jpeg","verifications":{"__typename":"VerifiedInfo","isBookAuthor":false},"bio":"I work as a scientific and robotics software developer for QuantStack in Paris and Berlin. We do Open Source for a living!","socialStats":{"__typename":"SocialStats","followerCount":689,"followingCount":77,"collectionFollowingCount":6},"allowNotes":true,"membership":null,"viewerEdge":{"__ref":"UserViewerEdge:userId:d6a88200753f-viewerId:lo_a19b4e21736c"},"twitterScreenName":"wuoulf"},"Paragraph:afa7ad786dad_0":{"__typename":"Paragraph","id":"afa7ad786dad_0","name":"a2b5","type":"H3","href":null,"layout":null,"metadata":null,"text":"ROS @ Jupyter","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_1":{"__typename":"Paragraph","id":"afa7ad786dad_1","name":"c61c","type":"H4","href":null,"layout":null,"metadata":null,"text":"Project Jupyter is a huge hit in data science, but it has not yet found widespread adoption in robotics. Today, we are releasing the first version of jupyter-ros, a collection of Jupyter interactive widgets inspired by Qt and RViz, to bring their features to the Jupyter ecosystem. This may be the right time for Jupyter-based developer tools, as cloud robotics is taking off.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"MediaResource:f618231fad654b7d80ecb2c11db65e5a":{"__typename":"MediaResource","id":"f618231fad654b7d80ecb2c11db65e5a","iframeSrc":"https:\u002F\u002Fcdn.embedly.com\u002Fwidgets\u002Fmedia.html?src=https%3A%2F%2Fgiphy.com%2Fembed%2FRi327iDKuC4pnExM4L%2Ftwitter%2Fiframe&url=https%3A%2F%2Fmedia.giphy.com%2Fmedia%2FRi327iDKuC4pnExM4L%2Fgiphy.mp4&image=https%3A%2F%2Fi.giphy.com%2Fmedia%2FRi327iDKuC4pnExM4L%2Fgiphy.gif&key=a19fcc184b9711e1b4764040d3dc5c07&type=text%2Fhtml&schema=giphy","iframeHeight":261,"iframeWidth":435,"title":"Animated GIF - Find & Share on GIPHY"},"Paragraph:afa7ad786dad_2":{"__typename":"Paragraph","id":"afa7ad786dad_2","name":"b7a7","type":"IFRAME","href":null,"layout":"INSET_CENTER","metadata":null,"text":"This may be the right time for Jupyter-based developer tools, as cloud robotics is taking off. A PR2 robot in the browser, and making him dance through the traditional Qt interface","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":{"__typename":"Iframe","mediaResource":{"__ref":"MediaResource:f618231fad654b7d80ecb2c11db65e5a"}},"mixtapeMetadata":null},"Paragraph:afa7ad786dad_3":{"__typename":"Paragraph","id":"afa7ad786dad_3","name":"8b26","type":"P","href":null,"layout":null,"metadata":null,"text":"Historically, the ROS (Robot Operating System) community has relied on Qt for building complex user interfaces. Nowadays, the Jupyter notebook and the ipywidgets framework offer a compelling alternative for several reasons:","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":18,"end":46,"href":"http:\u002F\u002Fwww.ros.org\u002F","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_4":{"__typename":"Paragraph","id":"afa7ad786dad_4","name":"e792","type":"ULI","href":null,"layout":null,"metadata":null,"text":"Code and interface are not separated — both are in the same notebook.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":23,"end":36,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_5":{"__typename":"Paragraph","id":"afa7ad786dad_5","name":"d584","type":"ULI","href":null,"layout":null,"metadata":null,"text":"Complex widgets using browser technology are possible: from JavaScript sliders to 3D with WebGL, real time video streaming with WebRTC…","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":60,"end":78,"href":"https:\u002F\u002Fgithub.com\u002Fjupyter-widgets\u002Fipywidgets","anchorType":"LINK","userId":null,"linkMetadata":null},{"__typename":"Markup","type":"A","start":90,"end":95,"href":"https:\u002F\u002Fgithub.com\u002Fmaartenbreddels\u002Fipyvolume","anchorType":"LINK","userId":null,"linkMetadata":null},{"__typename":"Markup","type":"A","start":97,"end":134,"href":"https:\u002F\u002Fgithub.com\u002Fmaartenbreddels\u002Fipywebrtc","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_6":{"__typename":"Paragraph","id":"afa7ad786dad_6","name":"815e","type":"ULI","href":null,"layout":null,"metadata":null,"text":"Works with any web browser — not bound to Linux, and no Qt applications need to be compiled.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_7":{"__typename":"Paragraph","id":"afa7ad786dad_7","name":"1a6a","type":"ULI","href":null,"layout":null,"metadata":null,"text":"Doesn’t need to run locally! Applications can run on a server far away, without any manual setup or installation procedure.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_8":{"__typename":"Paragraph","id":"afa7ad786dad_8","name":"9435","type":"P","href":null,"layout":null,"metadata":null,"text":"However, ROS does not play nicely with Jupyter. For example, rospy is inherently multi-threaded (every new ROS topic subscriber spawns a new thread). Debug printouts in callbacks result in Jupyter printing that content into the output area of the active notebook cell, quickly flooding the user interface — and there is no easy way to stop logging threads once started.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_9":{"__typename":"Paragraph","id":"afa7ad786dad_9","name":"10c5","type":"H4","href":null,"layout":null,"metadata":null,"text":"ipywidgets to the rescue: jupyter-ros","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_10":{"__typename":"Paragraph","id":"afa7ad786dad_10","name":"b37c","type":"P","href":null,"layout":null,"metadata":null,"text":"That is why jupyter-ros was created. It is a suite of plugins to the Jupyter ecosystem to make working with ROS inside Jupyter a breeze.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":12,"end":23,"href":"https:\u002F\u002Fgithub.com\u002FRoboStack\u002Fjupyter-ros","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_11":{"__typename":"Paragraph","id":"afa7ad786dad_11","name":"17a7","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__typename":"ImageMetadata","id":"1*35w3erSL2xz0mp9le6YNyg.png","originalHeight":2400,"originalWidth":4000,"focusPercentX":null,"focusPercentY":null,"alt":null},"text":"Subscribing with jupyter-ros produces an interactive widget","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_12":{"__typename":"Paragraph","id":"afa7ad786dad_12","name":"4281","type":"P","href":null,"layout":null,"metadata":null,"text":"First, when you subscribe using jupyter-ros, the function returns an ipywidget with a start\u002Fstop button and a dedicated output area for debug prints. Internally this re-routes all print outs from your subscriber thread to this Jupyter cell, and gives full control over the thread (by being able to stop and restart it at any time).","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_13":{"__typename":"Paragraph","id":"afa7ad786dad_13","name":"cdab","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__typename":"ImageMetadata","id":"1*yBgrLtyCGlaZcUQnFV9Jpg.png","originalHeight":2400,"originalWidth":4000,"focusPercentX":null,"focusPercentY":null,"alt":null},"text":"The jupyros publishing sugar","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_14":{"__typename":"Paragraph","id":"afa7ad786dad_14","name":"8f68","type":"P","href":null,"layout":null,"metadata":null,"text":"If you call the publish function in jupyter-ros, a widget is automatically generated from the message specification. For example, a ROS message String field automatically becomes a text input widget, a Float32 becomes a FloatSlider...","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"MediaResource:f29ba7e83b7ed03a133bcbed9335d3ad":{"__typename":"MediaResource","id":"f29ba7e83b7ed03a133bcbed9335d3ad","iframeSrc":"https:\u002F\u002Fcdn.embedly.com\u002Fwidgets\u002Fmedia.html?src=https%3A%2F%2Fgiphy.com%2Fembed%2FfSqNQ06Ujnuu8juH2t%2Ftwitter%2Fiframe&url=https%3A%2F%2Fmedia.giphy.com%2Fmedia%2FfSqNQ06Ujnuu8juH2t%2Fgiphy.mp4&image=https%3A%2F%2Fi.giphy.com%2Fmedia%2FfSqNQ06Ujnuu8juH2t%2Fgiphy-downsized-large.gif&key=a19fcc184b9711e1b4764040d3dc5c07&type=text%2Fhtml&schema=giphy","iframeHeight":299,"iframeWidth":435,"title":"Animated GIF - Find & Share on GIPHY"},"Paragraph:afa7ad786dad_15":{"__typename":"Paragraph","id":"afa7ad786dad_15","name":"3d72","type":"IFRAME","href":null,"layout":"INSET_CENTER","metadata":null,"text":"Live plotting IMU data from a BBC micro:bit","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":{"__typename":"Iframe","mediaResource":{"__ref":"MediaResource:f29ba7e83b7ed03a133bcbed9335d3ad"}},"mixtapeMetadata":null},"Paragraph:afa7ad786dad_16":{"__typename":"Paragraph","id":"afa7ad786dad_16","name":"4ea5","type":"P","href":null,"layout":null,"metadata":null,"text":"Another interesting functionality is the live plotting, similar to rqt_plot. For this we use bqplot, a “jupyter-native” solution to plotting. With jupyter-ros, you can select a couple of fields from your message, and they will be automatically plotted to a bqplot.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":93,"end":99,"href":"https:\u002F\u002Fgithub.com\u002Fbloomberg\u002Fbqplot","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_17":{"__typename":"Paragraph","id":"afa7ad786dad_17","name":"86f7","type":"H4","href":null,"layout":null,"metadata":null,"text":"Going 3-D","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_18":{"__typename":"Paragraph","id":"afa7ad786dad_18","name":"0f5a","type":"P","href":null,"layout":null,"metadata":null,"text":"Most robots are three dimensional, and so should be the visualizations! The go-to tool in the ROS ecosystem at the moment is RViz, a very powerful 3-D visualization tool.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_19":{"__typename":"Paragraph","id":"afa7ad786dad_19","name":"3de3","type":"P","href":null,"layout":null,"metadata":null,"text":"Some of RViz’s functionality has already been ported over to the web browser as part of the RobotWebTools effort. We’ve been able to piggy-back on their impressive work, and we’re releasing the first iteration of ROS3D Jupyter widgets. Currently, they allow you to programatically plug together RViz like visualizations for different data types, such as laser scans, robot trajectories, and 3D (URDF) models of the robot!","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":92,"end":105,"href":"http:\u002F\u002Frobotwebtools.org\u002F","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_20":{"__typename":"Paragraph","id":"afa7ad786dad_20","name":"1c31","type":"P","href":null,"layout":null,"metadata":null,"text":"Thanks to the ipywidgetification, you can now bring complex visualizations to the web, without writing any JavaScript, and arrange those visualizations freely in JupyterLab.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"MediaResource:aaf60d0cb0065c52e07236fe875b657a":{"__typename":"MediaResource","id":"aaf60d0cb0065c52e07236fe875b657a","iframeSrc":"https:\u002F\u002Fcdn.embedly.com\u002Fwidgets\u002Fmedia.html?src=https%3A%2F%2Fwww.youtube.com%2Fembed%2FmPvYZango2E%3Ffeature%3Doembed&url=http%3A%2F%2Fwww.youtube.com%2Fwatch%3Fv%3DmPvYZango2E&image=https%3A%2F%2Fi.ytimg.com%2Fvi%2FmPvYZango2E%2Fhqdefault.jpg&key=a19fcc184b9711e1b4764040d3dc5c07&type=text%2Fhtml&schema=youtube","iframeHeight":480,"iframeWidth":640,"title":"ROS widgets in JupyterLab"},"Paragraph:afa7ad786dad_21":{"__typename":"Paragraph","id":"afa7ad786dad_21","name":"3bc4","type":"IFRAME","href":null,"layout":"INSET_CENTER","metadata":null,"text":"Interactive widgets showing ROS data inside JupyterLab","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":{"__typename":"Iframe","mediaResource":{"__ref":"MediaResource:aaf60d0cb0065c52e07236fe875b657a"}},"mixtapeMetadata":null},"Paragraph:afa7ad786dad_22":{"__typename":"Paragraph","id":"afa7ad786dad_22","name":"4b20","type":"H4","href":null,"layout":null,"metadata":null,"text":"Jupyter, Widgets, and Cloud Robotics","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_23":{"__typename":"Paragraph","id":"afa7ad786dad_23","name":"3fe3","type":"P","href":null,"layout":null,"metadata":null,"text":"We hope that Jupyter, and the jupyter-ros widgets will play a big role in cloud robotics. In cloud robotics, some of the software powering one or multiple robots runs on powerful computers in data centers. For monitoring purposes, or development, Jupyter and JupyterLab are perfect candidates. Robot customers will be able to login to a single user-friendly interface, without having to install any custom software on their machine, or run a specialized operating system (ROS usually runs on Ubuntu). Exciting possibilities arise: it is already possible to run a Docker container running JupyterLab and jupyter-ros on the leading cloud robotics platforms, Rapyuta Robotics and their freshly launched platform rapyuta.io.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":656,"end":672,"href":"https:\u002F\u002Frapyuta-robotics.com","anchorType":"LINK","userId":null,"linkMetadata":null},{"__typename":"Markup","type":"A","start":709,"end":719,"href":"http:\u002F\u002Frapyuta.io","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_24":{"__typename":"Paragraph","id":"afa7ad786dad_24","name":"b579","type":"H4","href":null,"layout":null,"metadata":null,"text":"Installation & source","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_25":{"__typename":"Paragraph","id":"afa7ad786dad_25","name":"5c58","type":"P","href":null,"layout":null,"metadata":null,"text":"The jupyter-ros widgets can be installed from PyPI using","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_26":{"__typename":"Paragraph","id":"afa7ad786dad_26","name":"03b8","type":"PRE","href":null,"layout":null,"metadata":null,"text":"$ pip install jupyros\n$ jupyter nbextension enable --py --sys-prefix jupyros","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"CODE","start":22,"end":76,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_27":{"__typename":"Paragraph","id":"afa7ad786dad_27","name":"847a","type":"P","href":null,"layout":null,"metadata":null,"text":"The examples and the source code can be found on github: https:\u002F\u002Fgithub.com\u002Frobostack\u002Fjupyter-ros","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":57,"end":97,"href":"https:\u002F\u002Fgithub.com\u002Frobostack\u002Fjupyter-ros","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_28":{"__typename":"Paragraph","id":"afa7ad786dad_28","name":"85de","type":"P","href":null,"layout":null,"metadata":null,"text":"This work is still early stages and you might find some rough edges. We look forward to collaborating with the community to polish these widgets to the highest standards!","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_29":{"__typename":"Paragraph","id":"afa7ad786dad_29","name":"c5eb","type":"H4","href":null,"layout":null,"metadata":null,"text":"About QuantStack","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_30":{"__typename":"Paragraph","id":"afa7ad786dad_30","name":"9aba","type":"P","href":null,"layout":null,"metadata":null,"text":"QuantStack is located in the center of Europe (Paris). We are core Jupyter developers, and love ROS, and the cloud. If you are interested in working with us on professional user interfaces for developers or clients in the cloud, do not hesitate to send us an email: wolf.vollprecht@quantstack.net","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":0,"end":10,"href":"https:\u002F\u002Ftwitter.com\u002FQuantStack","anchorType":"LINK","userId":null,"linkMetadata":null},{"__typename":"Markup","type":"A","start":266,"end":296,"href":"mailto:wolf.vollprecht@quantstack.net","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_31":{"__typename":"Paragraph","id":"afa7ad786dad_31","name":"f85c","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__typename":"ImageMetadata","id":"1*puvws-ulE4ShvCd9inzo0g.png","originalHeight":null,"originalWidth":null,"focusPercentX":null,"focusPercentY":null,"alt":null},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:afa7ad786dad_32":{"__typename":"Paragraph","id":"afa7ad786dad_32","name":"e7e6","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__typename":"ImageMetadata","id":"1*WqG2vz1hl2X0-Z2TZFFSAQ.png","originalHeight":483,"originalWidth":800,"focusPercentX":null,"focusPercentY":null,"alt":null},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"CollectionViewerEdge:collectionId:95916e268