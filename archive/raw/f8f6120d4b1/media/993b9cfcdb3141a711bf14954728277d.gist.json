  "files": {
    "cluster.tf": {
      "filename": "cluster.tf",
      "type": "text/plain",
      "language": "HCL",
      "raw_url": "https://gist.githubusercontent.com/gouarin/17d9864ecd963e57155b7a5ee6ccad87/raw/adabffb67823dac20ad0c5cabc68ca4dd7ee4f8b/cluster.tf",
      "size": 1279,
      "truncated": false,
      "content": "# your Kubernetes cluster name here\ncluster_name = \"jhub\"\n\n# SSH key to use for access to nodes\npublic_key_path = \"~/.ssh/id_rsa.pub\"\n\n# image to use for bastion, masters, standalone etcd instances, and nodes\nimage = \"CentOS-7-x86_64-GenericCloud-20180108.qcow2\"\n# user on the node (ex. core on Container Linux, ubuntu on Ubuntu, etc.)\nssh_user = \"centos\"\n\n# 0|1 bastion nodes\nnumber_of_bastions = 0\n# standalone etcds\nnumber_of_etcd = 0\n\n# masters\nnumber_of_k8s_masters = 1\nnumber_of_k8s_masters_no_etcd = 0\nnumber_of_k8s_masters_no_floating_ip = 0\nnumber_of_k8s_masters_no_floating_ip_no_etcd = 0\nflavor_k8s_master = \"5e879c45-e709-4671-a38b-45ed0573dc38\"\n\n# nodes\nnumber_of_k8s_nodes = 0\nnumber_of_k8s_nodes_no_floating_ip = 2\nflavor_k8s_node = \"5e879c45-e709-4671-a38b-45ed0573dc38\"\n\n# GlusterFS\n# either 0 or more than one\nnumber_of_gfs_nodes_no_floating_ip = 2\ngfs_volume_size_in_gb = 100\n# Container Linux does not support GlusterFS\nimage_gfs = \"CentOS-7-x86_64-GenericCloud-20180108.qcow2\"\n# May be different from other nodes\nssh_user_gfs = \"centos\"\nflavor_gfs_node = \"5e879c45-e709-4671-a38b-45ed0573dc38\"\n\n# networking\n#network_name = \"<network>\"\nexternal_net = \"6cd08271-...\"\n#subnet_cidr = \"<cidr>\"\nfloatingip_pool = \"public\"\n\ndns_nameservers = [\"8.8.8.8\", \"8.8.4.4\"]",
      "encoding": "utf-8"
    }
  },
