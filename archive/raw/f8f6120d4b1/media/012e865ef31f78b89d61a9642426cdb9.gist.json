      "language": "Shell",
      "raw_url": "https://gist.githubusercontent.com/gouarin/0ad0527e1ee0bdea171cba76d11b2202/raw/8db09252c80970b4c29956bbc87c6ab2d3401bd3/rc_file",
      "size": 705,
      "truncated": false,
      "content": "#!/usr/bin/env bash\n\nexport OS_AUTH_URL=https://keystone.xxxxxx:5000/v3\nexport OS_PROJECT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\nexport OS_PROJECT_NAME=\"xxxxxxxx\"\nexport OS_USER_DOMAIN_NAME=\"xxxxxxxx\"\nif [ -z \"$OS_USER_DOMAIN_NAME\" ]; then unset OS_USER_DOMAIN_NAME; fi\n\n# unset v2.0 items in case set\nunset OS_TENANT_ID\nunset OS_TENANT_NAME\n\nexport OS_USERNAME=\"xxxxxxxx\"\nexport OS_REGION_NAME=\"xxxxxxxx\"\n# Don't leave a blank variable, unset it if it was empty\nif [ -z \"$OS_REGION_NAME\" ]; then unset OS_REGION_NAME; fi\n\nexport OS_INTERFACE=public\nexport OS_IDENTITY_API_VERSION=3\n\n# to be added\nexport OS_PASSWORD=\"xxxxxxxx\"\nexport OS_CLOUD=xxxxxxxx\nexport OS_CACERT=/home/loic/.certs/openstack_cacert.pem",
      "encoding": "utf-8"
    }
  },
