# Written by `medium-archive hugo`: how this site is built, not what it
# says. Hugo takes an address, a name and a language at the root of its
# configuration, so those three are here, and they are the site's own
# to change; everything the theme renders from -- the masthead, the
# footer line, the newsletter band, the share image -- is params.toml
# beside this file, and the landing page's blurb is content/_index.md.
# Everything below them is machinery, and every export writes this file
# fresh.
baseURL = $base_url
title = $title
defaultContentLanguage = $locale
locale = $locale

# ------------------------------------------------------------- machinery
# robots.txt from layouts/robots.txt: the sitemap's address, or a
# blanket disallow when params.toml sets "noindex"
enableRobotsTXT = true

# author terms are the names as written ("yuvipanda"), not title-cased
capitalizeListTitles = false

[pagination]
pagerSize = 24

# a feed announces new posts; the site itself is the archive
[services.rss]
limit = 20

[taxonomies]
tag = "tags"
author = "authors"

# related posts at the foot of each post (_partials/related.html): by
# shared tags first, then a shared author, then closeness in time;
# includeNewer, since an archive is read in any order
[related]
threshold = 60
includeNewer = true
toLower = true
[[related.indices]]
name = "tags"
weight = 100
[[related.indices]]
name = "authors"
weight = 30
[[related.indices]]
name = "date"
weight = 10

[markup.goldmark.renderer]
# some old bodies carry fragments of raw HTML; render them
unsafe = true

# fenced blocks with a language are highlighted by Chroma; classes
# rather than inline styles, so the site's stylesheet colours the
# tokens for both palettes (Chroma's default is Monokai inlined, a
# dark block whatever the page's scheme). The class names are
# Pygments', which the Pelican site's reader emits too, so one palette
# serves both engines.
[markup.highlight]
noClasses = false
