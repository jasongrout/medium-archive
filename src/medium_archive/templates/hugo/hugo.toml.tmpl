# Written by `medium-archive hugo` and overwritten on every export.
# The data the theme renders from is in params.toml beside this file.
baseURL = $base_url
title = $title
defaultContentLanguage = $locale
locale = $locale

# serve layouts/robots.txt, which disallows everything when params.toml
# sets noindex
enableRobotsTXT = true

# automatic titles, such as an author slug ("yuvipanda"), stay as written
capitalizeListTitles = false

[pagination]
pagerSize = 24

[services.rss]
limit = 20

# :year is the year of the post's date, not its directory; matches the
# Pelican site's ARTICLE_URL.
[permalinks.page]
posts = "/posts/:year/:slug/"

[taxonomies]
tag = "tags"
author = "authors"

# for _partials/related.html
[related]
threshold = 60
includeNewer = true
toLower = true
[[related.indices]]
name = "tags"
weight = 100
[[related.indices]]
name = "authors"
weight = 30
[[related.indices]]
name = "date"
weight = 10

[markup.goldmark.renderer]
# some post bodies contain raw HTML
unsafe = true

# CSS classes instead of inline styles, so the stylesheet colours tokens
# in both palettes; the class names match Pygments', as in the Pelican site
[markup.highlight]
noClasses = false
