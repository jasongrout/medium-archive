{{- /* One term page per data/tags.yaml entry: the path stays the slug
       (/tags/<slug>/), the title is the tag's display name. A tag missing
       from the file gets Hugo's default page, titled by its slug. */ -}}
{{ range $slug, $name := hugo.Data.tags }}
{{ $.AddPage (dict "kind" "term" "path" $slug "title" $name) }}
{{ end }}
