{{- /* One term page per entry in data/tags.json (tag slug -> the name
       it is shown under). The page's title is what every place Hugo
       renders the term picks up -- cards, the tag page and its <title>,
       the chip index, the per-tag feed -- while its path, and so the
       /tags/<slug>/ URL, stays the slug the posts' front matter carries.
       A tag missing from the map still gets its page from Hugo, titled
       by its slug. To rename a tag, edit data/tags.json. */ -}}
{{ range $slug, $name := hugo.Data.tags }}
{{ $.AddPage (dict "kind" "term" "path" $slug "title" $name) }}
{{ end }}
