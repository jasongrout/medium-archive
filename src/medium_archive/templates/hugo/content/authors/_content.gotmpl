{{- /* One term page per data/authors.yaml entry: the path stays the slug
       (/authors/<slug>/), the title is the author's name, or the slug when
       the entry has none. */ -}}
{{ range $slug, $author := hugo.Data.authors }}
{{ $.AddPage (dict "kind" "term" "path" $slug "title" (default $slug $author.name)) }}
{{ end }}
