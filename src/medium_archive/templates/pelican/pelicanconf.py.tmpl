# Generated by `medium-archive pelican`; do not edit.
# Site title/description/intro come from <out>/site.json.
SITENAME = $title
SITESUBTITLE = $description
SITEURL = $base_url
TIMEZONE = "UTC"
DEFAULT_LANG = "en"
DEFAULT_DATE_FORMAT = "%B %d, %Y"

# Jinja emits every {{ }} raw unless told otherwise, and pelican leaves
# it that way (its own default JINJA_ENVIRONMENT sets no autoescape) so
# that a theme can render article.content, which really is HTML. But a
# post title is not: it is the plain text of its Title: header, as are
# tag names and author names -- and in an archived publication those
# come from whoever wrote the post, not from whoever builds the site, so
# a title reading `<script>...` would otherwise become a running script
# in every page that renders it. The theme escapes by default instead and
# marks the few values that are genuinely HTML with |safe. Hugo's
# templates escape contextually, so this is what keeps the two engines
# rendering the same title the same way. The other three keys are
# pelican's own defaults, restated because this setting replaces them.
JINJA_ENVIRONMENT = {
    "autoescape": True,
    "trim_blocks": True,
    "lstrip_blocks": True,
    "extensions": [],
}

PATH = "content"
THEME = "theme"
ARTICLE_PATHS = ["posts"]
STATIC_PATHS = ["posts"]        # colocated images, placed via {attach}
PAGE_PATHS = []
# directory-style URLs throughout, matching the hugo build's scheme
ARTICLE_URL = "posts/{slug}/"
ARTICLE_SAVE_AS = "posts/{slug}/index.html"
TAG_URL = "tags/{slug}/"
TAG_SAVE_AS = "tags/{slug}/index.html"
TAGS_URL = "tags/"
TAGS_SAVE_AS = "tags/index.html"
AUTHOR_URL = "authors/{slug}/"
AUTHOR_SAVE_AS = "authors/{slug}/index.html"
AUTHORS_URL = "authors/"
AUTHORS_SAVE_AS = "authors/index.html"
ARCHIVES_URL = "archives/"
ARCHIVES_SAVE_AS = "archives/index.html"
PAGINATION_PATTERNS = (
    (1, "{url}", "{save_as}"),
    (2, "{base_name}/page/{number}/", "{base_name}/page/{number}/index.html"),
)
DEFAULT_PAGINATION = 24
DEFAULT_CATEGORY = "posts"
SLUGIFY_SOURCE = "basename"     # slugs are explicit in each article anyway
DIRECT_TEMPLATES = ["index", "tags", "authors", "archives"]
TEMPLATE_PAGES = {"search.html": "search/index.html"}
CATEGORY_URL = ""               # tags and authors classify posts;
CATEGORY_SAVE_AS = ""           # the category axis stays unused
AVATAR = $avatar
