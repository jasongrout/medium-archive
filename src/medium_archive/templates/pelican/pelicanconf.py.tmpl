# tag slug -> the name the tag is shown under. Tags reach Pelican as
# slugs, so tag.slug and every /tags/<slug>/ URL are exact rather than
# whatever Pelican's slugify would make of a name like "C++"; the site
# plugin below names each Tag object from this map once the tags are
# collected, which is what the theme and the feeds then render.
TAG_DISPLAY = $tag_display

FEED_ALL_ATOM = "feeds/all.atom.xml"
FEED_MAX_ITEMS = 20             # a feed announces new posts; the site
                                # itself is the archive
CATEGORY_FEED_ATOM = None
TAG_FEED_ATOM = "feeds/tag-{slug}.atom.xml"
AUTHOR_FEED_ATOM = "feeds/author-{slug}.atom.xml"
AUTHOR_FEED_RSS = None

from markdown.extensions import Extension as _Extension
from markdown.treeprocessors import Treeprocessor as _Treeprocessor


class _LazyImages(_Extension):
    # body images load lazily, so a reader doesn't fetch every
    # below-the-fold full-resolution image up front
    def extendMarkdown(self, md):
        class _Lazy(_Treeprocessor):
            def run(self, root):
                for img in root.iter("img"):
                    img.set("loading", "lazy")
        md.treeprocessors.register(_Lazy(md), "lazy-images", 5)


MARKDOWN = {
    "extension_configs": {
        "markdown.extensions.codehilite": {"css_class": "highlight"},
        "markdown.extensions.extra": {},
        "markdown.extensions.meta": {},
        # heading ids give search results per-section anchors
        "markdown.extensions.toc": {},
    },
    "extensions": [_LazyImages()],
    "output_format": "html5",
}
