# site.json's "intro": the landing-page blurb. It is Markdown, like
# the hugo site's content/_index.md, and is rendered here because
# Jinja has no Markdown filter of its own; index.html emits it.
import markdown as _markdown
_INTRO_MD = $intro
INTRO = _markdown.markdown(_INTRO_MD) if _INTRO_MD else None
