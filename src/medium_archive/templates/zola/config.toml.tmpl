# Generated by `medium-archive zola`; do not edit.
# Site title/description/intro come from <out>/site.json.
base_url = $base_url
title = $title
description = $description
generate_feeds = true
feed_filenames = ["atom.xml"]
# a feed announces new posts; the site itself is the archive
feed_limit = 20
build_search_index = true

taxonomies = [
    { name = "tags", feed = true },
    { name = "authors", feed = true },
]

[link_checker]
# old posts carry in-page anchor links whose anchors never survived the
# original Medium conversion; report them without failing the build
internal_level = "warn"

[markdown]
highlight_code = true
